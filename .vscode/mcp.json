{
  "servers": {
    "fastedge-assistant": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-v",
        "${workspaceFolder}:/workspace",
        "-v",
        "fastedge-session:/run/fastedge:ro",
        "-e",
        "WORKSPACE_ROOT=/workspace",
        "-e",
        "FASTEDGE_SESSION=ephemeral",
        "-e",
        "GCORE_API_BASE=https://api.preprod.world",
        "ghcr.io/g-core/fastedge-mcp-server:latest"
      ]
    }
  }
}
